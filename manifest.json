{
    "manifest_version": 3,
    "name": "Date Bookmark Manager",
    "version": "1.3.0",
    "description": "ブックマークを自動で日付ごとに整理するChrome拡張機能。",
    "permissions": [
        "bookmarks",
        "contextMenus",
        "storage",
        "activeTab"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Date Bookmark Manager"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}