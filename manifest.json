{
    "manifest_version": 3,
    "name": "Date Bookmark Manager",
    "version": "1.1.2",
    "description": "ブックマークを自動で日付ごとに整理するChrome拡張機能。",
    "permissions": [
        "bookmarks",
        "contextMenus",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}